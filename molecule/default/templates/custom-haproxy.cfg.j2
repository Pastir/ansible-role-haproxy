{{ ansible_managed | comment }}
# rendered from a project template (molecule)
global
    log /dev/log local0
    user haproxy
    group haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin

defaults
    mode tcp
    timeout connect 5s
    timeout client 1m
    timeout server 1m

userlist molecule_users
    user admin insecure-password {{ __molecule_secret }}

listen changed
    bind 127.0.0.1:9999
    server s1 127.0.0.1:22
